@startuml
skinparam {
    BackgroundColor #ADD8E6
    BorderColor Black
    Shadowing false
    Handwritten true
    Activity {
        BackgroundColor #ecf1f9ff
        BorderColor Black
    }
}

start

:Launch Game;

repeat
    :Control Panel;
    if (User Choice?) then (Run Game)

        repeat
            :Main Menu;
            if (Menu Option?) then (Play Levels)

                :Ask Player Name;
                :Choose Level (1-17);
                    :Display Board;
                    repeat
                        :Player Input (WASD / IJKL / Z);
                        :Update Board;
                        :Check Game State;
                    repeat while (Game Running?)

                    if (Win?) then (yes)
                        :Show Win Screen;
                        if (Draw Path?) then (yes)
                            :Display Path;
                        endif
                    else
                        :Show Game Over Screen;
                    endif

            elseif (Computer Play)
                :Choose Level (1-17);
                :Choose Algorithm:
                *BFS
                *DFS
                *UCS
                *Hill Climbing
                *A_Star;
                :Run Solver;
                :Show Solution (path);

            elseif (View Stats)
                :Select Level Stats;
                :Display Stats Table;

            elseif (Settings)
                :Choose Theme:
                *Classic
                *High Contrast
                *Legacy;

            elseif (About)
                :Show About Screen;

            else (Quit Game)
                break
            endif

        repeat while (Back to Main Menu)

    elseif (Rebuild)
        :Clean & Build Project;
    else (Exit)
        stop
    endif

repeat while (Control Panel Active)

@enduml
